# ======================
# Django secret key used for cryptographic signing (importent)
# ======================
SECRET_KEY=django-insecure-sk_test_1234567890abcdef 

# ======================
# Secret key used within Docker environment (optional, can be same or different)
# ======================
DOCKER_SECRET_KEY=django-insecure-docker-1234567890abcdef

# ======================
# Cloudinary configuration for media upload (optional)
# ======================
CLOUD_NAME=examplecloud
CLOUD_API_KEY=123456789012345
CLOUD_API_SECRET=fakecloudsecretkey123

# ======================
# Local database configuration (importen for local test )
# ======================
DB_NAME=my_local_db
DB_USER=localuser
DB_PASSWORD=localpassword123
DB_HOST=localhost
DB_PORT=5432

# ======================
# Docker/Postgres DB (important)
# ======================
DOCKER_DB_NAME=my_docker_db
DOCKER_DB_USER=dockeruser
DOCKER_DB_PASSWORD=dockerpassword123
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432

POSTGRES_DB=my_docker_db  
POSTGRES_USER=dockeruser
POSTGRES_PASSWORD=dockerpassword123

# ======================
# Stripe API keys for payment processing (test environment) (optional)
# ======================
STRIPE_PUBLISHABLE_KEY=pk_test_abcdef123456
STRIPE_SECRET_KEY=sk_test_abcdef123456

# ======================
# Email configuration (used for sending system emails)
# ======================
EMAIL_HOST_USER=admin@example.com
EMAIL_HOST_PASSWORD=supersecureemailpass

# ======================
# Docker-specific Stripe and email configuration (optional)
# ======================
DOCKER_STRIPE_PUBLISHABLE_KEY=pk_docker_test_123456
DOCKER_STRIPE_SECRET_KEY=sk_docker_test_123456
DOCKER_EMAIL_HOST_USER=docker@example.com
DOCKER_EMAIL_HOST_PASSWORD=dockeremailpass123

# ======================
# ALLOWED HOSTS (important)
# ======================
ALLOWED_HOSTS=0.0.0.0, localhost, 127.0.0.1,

# ======================
# SUPERUSER (important)
# ======================

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=adminpassword123
DJANGO_SUPERUSER_EMAIL=admin@example.com



